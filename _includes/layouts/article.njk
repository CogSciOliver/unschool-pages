---
layout: layouts/base.njk
---

{# CANON: directory section + parent-owned bonus #}
{% set currentSection = page | contentSection %}
{% set attachedBonus = collections.bonusContent | bonusFor(bonus) %}
<div class="article-layout">
  <article class="article notebook-page">
    <header class="article-header">
      {% if currentSection %}<div class="stamp">{{ currentSection | sectionLabel }}</div>{% endif %}
      <div class="line-space-reset"></div>
      <h1>{{ title }}</h1>
      {% if description %}<p class="lede">{{ description }}</p>{% endif %}
    </header>

        {% if attachedBonus %}
    <div class="article-bonus-cta">
      <a
        class="card-meta article-bonus-link"
        href="{{ attachedBonus.url }}"
      >
        Bonus:
        {{ attachedBonus.data.bonus_label or attachedBonus.data.title }}
        →
      </a>
    </div>
  {% endif %}

  <div class="article-body">
      {{ content | safe }}
    </div>
    <hr class="article-divider" />
    <p>Remember Unschooling, It's Easy!" --Danii Oliver</p>
  </article>


  {# BONUS CONTENT CONNECTED TO THIS ARTICLE #}



  {% if attachedBonus %}

  <section class="section-block article-bonus">

    <div class="section-heading">
      <div class="stamp">Bonus Content</div>
      <h2>Keep going</h2>
    </div>

    <div class="card-grid card-grid--related">

      <article class="post-card notebook-panel">

        {% if attachedBonus.data.format %}
          <div class="card-meta">
            {{ attachedBonus.data.format }}
          </div>
        {% endif %}

        <h3>
          <a href="{{ attachedBonus.url }}">
            {{ attachedBonus.data.bonus_label or attachedBonus.data.title }}
          </a>
        </h3>

        {% if attachedBonus.data.description %}
          <p>{{ attachedBonus.data.description }}</p>
        {% endif %}

        <a
          class="card-meta"
          href="{{ attachedBonus.url }}"
        >
          Open Bonus →
        </a>

      </article>

    </div>

  </section>

  {% endif %}


  {% set related = collections.published | inDirectory(currentSection, page.url) %}
  {% if related.length %}
  <section class="section-block article-related">
    <div class="section-heading">
      <div class="stamp">Want to Keep Going?</div>
      <h2>More from {{ currentSection | sectionLabel }}</h2>
    </div>
    <div class="card-grid card-grid--related">
      {% for post in related %}
      {% if loop.index <= 3 %}
        <article class="post-card notebook-panel">
        <div class="line-space-reset"></div>
        <div class="card-meta">{{ post.data.format | replace("-", " ") | title }}</div>
        <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
        <p>{{ post.data.description }}</p>
        </article>
        {% endif %}
        {% endfor %}
    </div>
  </section>
  {% endif %}
</div>